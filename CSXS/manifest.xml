<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.starsai.panel" ExtensionBundleVersion="0.7.58"
  ExtensionBundleName="Stars-AI" ExtensionBundleDescription="Stars-AI · 连接本地 ComfyUI 的 Photoshop AI 修图助手">
  <ExtensionList>
    <Extension Id="com.starsai.panel" Version="0.7.58" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PHXS" Version="[20.0,99.9]" />
      <Host Name="PHSP" Version="[20.0,99.9]" />
      <Host Name="PHPP" Version="[24.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.starsai.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <!-- 0.7.58：直连 host.jsx。
               为什么不挂 boot.jsx：CEP 的 evalScript 环境里 $.evalFile / eval 都可能被阻断
               （三条装载路径全失败的实测结论），所以唯一稳的路是让 ScriptPath 直接加载。
               代价是 host.jsx 必须 < 64K 字符 —— 历史注释已搬到 jsx/NOTES.md，
               现在 59,611 字符；test-workshops.js 有体积守卫断言。 -->
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--disable-web-security</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Stars-AI</Menu>
          <Geometry>
            <Size>
              <Height>960</Height>
              <Width>420</Width>
            </Size>
            <MinSize>
              <Height>520</Height>
              <Width>340</Width>
            </MinSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./assets/icon_23.png</Icon>
            <Icon Type="RollOver">./assets/icon_23.png</Icon>
            <Icon Type="DarkNormal">./assets/icon_23.png</Icon>
            <Icon Type="DarkRollOver">./assets/icon_23.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
